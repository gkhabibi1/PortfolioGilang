# Meta Conversions API & Pixel Credentials
# Get your Meta Pixel ID from Meta Events Manager (Settings > Pixel ID)
META_PIXEL_ID=your_meta_pixel_id_here

# Get your Conversions API Access Token from Meta Events Manager (Settings > Conversions API > Generate access token)
META_CAPI_TOKEN=your_meta_capi_access_token_here

# Optional: Set test_event_code when testing events in Meta Events Manager (Test Events tab)
# META_TEST_EVENT_CODE=TEST12345
